# Copy to .env and fill in. Never commit the real .env.

# --- Required ---
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# --- Models ---
GROQ_MODEL=openai/gpt-oss-20b
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- Retrieval ---
# bm25   = lexical only, ~110 MB RSS, sub-second boot (works on Render free)
# hybrid = FAISS + BM25, ~600 MB RSS, needs requirements-hybrid.txt and >=1 GB RAM
RETRIEVAL_MODE=bm25
TOP_K=5
RERANK_TOP_K=3
# LLM reranking costs an extra Groq round trip per query; off by default.
USE_LLM_RERANK=false

# --- Server ---
# Render injects PORT automatically; set it locally only if 8000 is taken.
PORT=8000
HOST=0.0.0.0
# Comma-separated frontend origins, or * for any.
ALLOWED_ORIGINS=*
